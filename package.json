{
  "name": "trading",
  "version": "0.1.0",
  "private": true,
  "description": "Handmade Binance trading interface with a Fastify backend, SolidJS UI, and reusable bot package.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install && node scripts/bootstrap-ml.mjs && npm run build",
    "dev": "concurrently -n server,web -c green,cyan \"npm run dev -w @trading/server\" \"npm run dev -w @trading/web\"",
    "build": "npm run build -w @trading/bot-algo && npm run build -w @trading/storage && npm run build -w @trading/server && npm run build -w @trading/web",
    "test": "npm test -w @trading/bot-algo && npm test -w @trading/storage && npm test -w @trading/server",
    "typecheck": "npm run typecheck -w @trading/bot-algo && npm run typecheck -w @trading/storage && npm run typecheck -w @trading/server && npm run typecheck -w @trading/web",
    "storage:audit": "tsx scripts/storage-maintenance.ts audit",
    "storage:gc": "tsx scripts/storage-maintenance.ts gc",
    "storage:dedupe": "tsx scripts/storage-maintenance.ts dedupe",
    "storage:migrate": "tsx scripts/migrate-ml-storage.ts",
    "benchmark:strategies": "tsx scripts/benchmark-strategies.ts",
    "benchmark:sigmoid-sigma": "tsx scripts/benchmark-sigmoid-sigma-fit.ts",
    "benchmark:kama:cuda": "tsx scripts/benchmark-vw-kama-cuda.ts",
    "benchmark:kama:value:cuda": "tsx scripts/benchmark-vw-kama-value-cuda.ts",
    "benchmark:kama:cuda:7d": "tsx scripts/compare-vw-kama-cuda-7d.ts",
    "build:cuda": "node scripts/build-vw-kama-cuda.mjs",
    "search:kama": "tsx scripts/search-volume-weighted-kama.ts",
    "audit:kama": "tsx scripts/audit-vw-kama-global.ts",
    "fetch:candles": "tsx scripts/fetch-binance-spot-candles.ts",
    "fetch:agg-trades": "tsx scripts/fetch-binance-spot-agg-trades.ts",
    "test:agg-trades": "node --conditions=development --import tsx --test scripts/fetch-binance-spot-agg-trades.test.ts",
    "fetch:futures-metrics": "tsx scripts/fetch-binance-usdm-metrics.ts",
    "test:futures-metrics": "node --conditions=development --import tsx --test scripts/fetch-binance-usdm-metrics.test.ts",
    "fetch:futures-klines": "tsx scripts/fetch-binance-usdm-klines.ts",
    "test:futures-klines": "node --conditions=development --import tsx --test scripts/fetch-binance-usdm-klines.test.ts",
    "fetch:futures-book-depth": "tsx scripts/fetch-binance-usdm-book-depth.ts",
    "test:futures-book-depth": "node --conditions=development --import tsx --test scripts/fetch-binance-usdm-book-depth.test.ts",
    "basis:binance": "tsx scripts/analyze-binance-portfolio-basis.ts",
    "basis:compare-scales": "tsx scripts/compare-binance-scale-bases.ts",
    "basis:backtest-index": "tsx scripts/backtest-binance-multiscale-index.ts",
    "verify:risk": "node --conditions=development --import tsx --test packages/bot-algo/test/simulated-trading-api.test.ts apps/server/test/bot-backtest.test.ts",
    "backtest:pathologies": "tsx scripts/collect-pathological-backtests.ts",
    "experiment:loop": "tsx scripts/experiment-agent-loop.ts",
    "calibrate:indicator-predictor": "tsx scripts/calibrate-handcrafted-indicator-predictor.ts",
    "calibrate:direct-indicator-predictor": "tsx scripts/calibrate-direct-indicator-predictor.ts",
    "mlp:bootstrap": "node scripts/bootstrap-ml.mjs",
    "mlp:build-contract": "npm run build -w @trading/bot-algo",
    "mlp:dataset": "npm run mlp:build-contract && node scripts/run-node-with-ml-libs.mjs node_modules/tsx/dist/cli.mjs scripts/build-mlp-dataset.ts --plan ml/training-plan.json",
    "mlp:refine": "npm run mlp:build-contract && node scripts/run-node-with-ml-libs.mjs node_modules/tsx/dist/cli.mjs scripts/build-mlp-dataset.ts --plan ml/training-plan.json --refinement-pass 1",
    "mlp:train": "node scripts/run-ml-python.mjs ml/train_mlp.py",
    "mlp:test": "node scripts/run-ml-python.mjs -m unittest discover -s ml -p test_*.py",
    "mlp:verify": "npm run mlp:build-contract && node scripts/run-node-with-ml-libs.mjs scripts/verify-mlp-model.mjs",
    "mlp:run": "node scripts/run-node-with-ml-libs.mjs scripts/run-mlp-training.mjs",
    "mlp:prepare": "node scripts/run-node-with-ml-libs.mjs scripts/run-mlp-training.mjs --dataset-only",
    "mlp:resume": "node scripts/run-node-with-ml-libs.mjs scripts/run-mlp-training.mjs --training-only",
    "mlp:study:frozen-production": "node scripts/run-node-with-ml-libs.mjs scripts/run-mlp-training.mjs --frozen-study-only",
    "mlp:train:production-minute": "node scripts/run-node-with-ml-libs.mjs scripts/run-mlp-training.mjs --production-minute",
    "mlp:status": "node scripts/run-node-with-ml-libs.mjs scripts/mlp-training-control.mjs status",
    "mlp:finalize": "node scripts/run-node-with-ml-libs.mjs scripts/mlp-training-control.mjs finalize",
    "mlp:study-loss-weights": "node scripts/run-node-with-ml-libs.mjs scripts/run-mlp-joint-study.mjs",
    "mlp:study-loss-weights:status": "node scripts/run-node-with-ml-libs.mjs scripts/mlp-joint-study-status.mjs",
    "mlp:study-loss-weights:exhaustive": "node scripts/run-node-with-ml-libs.mjs scripts/run-mlp-joint-study.mjs --study exhaustiveLossWeightStudy",
    "mlp:study-loss-weights:exhaustive:status": "node scripts/run-node-with-ml-libs.mjs scripts/mlp-joint-study-status.mjs --study exhaustiveLossWeightStudy",
    "mlp:study-loss-weights:exhaustive:queue": "node scripts/queue-mlp-exhaustive-study.mjs",
    "mlp:study-dynamic:analyze": "node scripts/run-ml-python.mjs ml/dynamic_study_analysis.py",
    "mlp:study-dynamic:run": "node scripts/run-ml-python.mjs ml/run_dynamic_curriculum.py",
    "mlp:study-dynamic:queue": "node scripts/run-ml-python.mjs ml/run_dynamic_curriculum.py --wait-for-source",
    "mlp:study-dynamic:dry-run": "node scripts/run-ml-python.mjs ml/run_dynamic_curriculum.py --dry-run",
    "mlp:study-dynamic:status": "node scripts/mlp-dynamic-curriculum-status.mjs",
    "mlp:study-adaptive:run": "node scripts/run-ml-python.mjs ml/run_adaptive_curriculum.py",
    "mlp:study-adaptive:dry-run": "node scripts/run-ml-python.mjs ml/run_adaptive_curriculum.py --dry-run",
    "mlp:study-adaptive:no-entropy:run": "node scripts/run-ml-python.mjs ml/run_adaptive_curriculum.py --study-key adaptiveCurriculumStudyNoEntropy",
    "mlp:study-adaptive:no-entropy:dry-run": "node scripts/run-ml-python.mjs ml/run_adaptive_curriculum.py --study-key adaptiveCurriculumStudyNoEntropy --dry-run",
    "mlp:study-adaptive:no-entropy:status": "node scripts/mlp-adaptive-curriculum-status.mjs --study-key adaptiveCurriculumStudyNoEntropy",
    "mlp:study-adaptive:no-entropy:watch": "node scripts/mlp-adaptive-curriculum-status.mjs --study-key adaptiveCurriculumStudyNoEntropy --watch",
    "mlp:study-adaptive:status": "node scripts/mlp-adaptive-curriculum-status.mjs",
    "mlp:study-adaptive:watch": "node scripts/mlp-adaptive-curriculum-status.mjs --watch",
    "mlp:curriculum:minute-delay": "node scripts/run-node-with-ml-libs.mjs scripts/run-mlp-delay-curriculum.mjs --plan ml/training-plans/mlp-direct-oracle-temporal-v12-minute-curriculum-60m-to-0m-oracle-mi-half-scratch.json",
    "mlp:curriculum:minute-delay:status": "node scripts/run-node-with-ml-libs.mjs scripts/mlp-training-control.mjs status --plan ml/training-plans/mlp-direct-oracle-temporal-v12-minute-curriculum-60m-to-0m-oracle-mi-half-scratch.json",
    "mlp:experiment:return-oracle-ce": "node scripts/run-ml-python.mjs ml/train_return_oracle_ce.py --plan ml/training-plans/return-oracle-ce-shrinking-v1.json",
    "mlp:experiment:return-oracle-ce:prepare": "node scripts/run-ml-python.mjs ml/train_return_oracle_ce.py --plan ml/training-plans/return-oracle-ce-shrinking-v1.json --prepare-only",
    "mlp:experiment:joint-price-oracle": "node scripts/run-ml-python.mjs ml/train_joint_price_oracle.py --plan ml/training-plans/joint-price-oracle-decision-conditioned-v3.json",
    "mlp:experiment:joint-price-oracle:check": "node scripts/run-ml-python.mjs ml/train_joint_price_oracle.py --plan ml/training-plans/joint-price-oracle-decision-conditioned-v3.json --check-data",
    "mlp:experiment:joint-price-oracle:export": "node scripts/run-ml-python.mjs ml/export_joint_price_oracle.py --plan ml/training-plans/joint-price-oracle-decision-conditioned-v3.json",
    "mlp:experiment:joint-price-oracle:v2:resume": "node scripts/run-ml-python.mjs ml/train_joint_price_oracle.py --plan ml/training-plans/joint-price-oracle-tide-rlinear-dlinear-v1.json",
    "mlp:experiment:joint-price-oracle:calibrate": "node scripts/run-ml-python.mjs ml/calibrate_joint_price_oracle.py --plan ml/training-plans/joint-price-oracle-decision-conditioned-v3.json",
    "mlp:experiment:joint-price-oracle:backtest": "node scripts/run-node-with-ml-libs.mjs node_modules/tsx/dist/cli.mjs scripts/backtest-joint-price-oracle.ts",
    "mlp:benchmark:fitter": "node scripts/run-ml-python.mjs --env TRADING_MLP_TEACHER_COMPILE=0 ml/benchmark_teacher_fitter.py",
    "mlp:benchmark:temporal": "npm run mlp:build-contract && node scripts/run-node-with-ml-libs.mjs node_modules/tsx/dist/cli.mjs scripts/benchmark-mlp-temporal-cadence.ts",
    "mlp:benchmark:oracle": "node scripts/run-node-with-ml-libs.mjs node_modules/tsx/dist/cli.mjs scripts/profile-exposure-value-oracle-cuda.ts",
    "start": "npm run start -w @trading/server"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.2",
    "adm-zip": "0.6.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
