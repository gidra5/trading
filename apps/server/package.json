{
  "name": "@trading/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "TMPDIR=/tmp NODE_OPTIONS=--conditions=development node ../../scripts/run-node-with-ml-libs.mjs node_modules/tsx/dist/cli.mjs watch apps/server/src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --conditions=development --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node ../../scripts/run-node-with-ml-libs.mjs apps/server/dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
    "@trading/bot-algo": "*",
    "fastify": "^5.1.0",
    "onnxruntime-node": "^1.27.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2"
  }
}
