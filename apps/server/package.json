{
  "name": "@trading/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build:oracle -w @trading/bot-algo",
    "pretypecheck": "npm run build:oracle -w @trading/bot-algo",
    "dev": "node --conditions=development --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --conditions=development --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node --conditions=development --import tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.0.1",
    "@trading/bot-algo": "*",
    "@trading/storage": "*",
    "adm-zip": "0.6.0",
    "better-sqlite3": "^13.0.3",
    "binance": "^3.6.4",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "onnxruntime-node": "^1.27.0",
    "ws": "^8.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2"
  }
}
