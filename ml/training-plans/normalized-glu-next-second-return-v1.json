        "newtonSchulzSteps": 3,
        "adjustLearningRate": "match_rms_adamw",
        "epsilon": 1e-7,
        "weightDecay": 0
      },
      "adamw": {
        "betas": [0.9, 0.999],
        "epsilon": 1e-8,
        "weightDecay": 0
      }
    },
    "learningRateSchedule": {
      "type": "reduce-on-validation-plateau",
      "factor": 0.5,
      "patience": 4,
      "threshold": 0.000001,
      "minimumLearningRate": 0.000001
    },
    "earlyStoppingPatience": 8,
    "gradientClip": 100,
    "seed": 1337,
    "device": "cuda",
    "mixedPrecision": "bfloat16"
  }
}
