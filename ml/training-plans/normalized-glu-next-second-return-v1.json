{
  "id": "normalized-glu-next-second-return-one-layer-v1",
  "label": "One learned-radius normalized GLU: 120x1s returns to next 1s return",
  "sourceDatasetDir": "data/training/datasets/mlp-direct-oracle-temporal-v12-delay-3600s-full-minute-oracle",
  "datasetDir": "data/training/datasets/normalized-glu-next-second-return-one-layer-v1",
  "runDir": "data/training/runs/normalized-glu-next-second-return-one-layer-v1",
  "historyDir": "data/market/immutable/refs/candles/spot-btcusdt/btcusdt/1s",
  "testExamples": 1000000,
  "architecture": {
    "contract": "next-return-fused-glu-stack-independent-branch-centering-sqrt-learned-radius-full-a-post-bias-v2",
    "widths": [512],
    "dropout": 0.05,
    "dropoutRate": 0.5,
    "initialRadius": 0.0031622776601683794,
    "minimumRadius": 0.0001
  },
  "training": {
    "epochs": 24,
    "batchSize": 32768,
    "evaluationBatchSize": 65536,
    "learningRate": 0.0001,
    "optimizer": {
      "type": "hybrid-muon-adamw",
      "muon": {
        "momentum": 0.95,
