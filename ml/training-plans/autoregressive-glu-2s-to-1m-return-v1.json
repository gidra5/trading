{
  "id": "autoregressive-glu-2s-to-1m-return-v1",
  "label": "Full-BPTT 2s GLU rollout to one next-minute return",
  "sourceDatasetDir": "data/training/datasets/mlp-direct-oracle-temporal-v12-delay-3600s-full-minute-oracle",
  "datasetDir": "data/training/datasets/autoregressive-glu-2s-to-1m-return-v1",
  "runDir": "data/training/runs/autoregressive-glu-2s-to-1m-return-v1",
  "historyDir": "data/market/immutable/refs/candles/spot-btcusdt/btcusdt/1s",
  "initialCheckpoint": "data/training/runs/horizon-cumulative-only-glu-2s-long-v1/checkpoints/best.json",
  "testExamples": 15000,
  "testTailOffsetExamples": 2575000,
  "evaluateTest": false,
  "architecture": {
    "contract": "autoregressive-pretrained-two-second-glu-to-single-minute-return-v1",
    "horizonSeconds": 60,
    "chunkSeconds": 2,
    "widths": [512],
    "dropout": 0.05,
    "dropoutRate": 0.5,
    "initialRadius": 0.0031622776601683794,
    "minimumRadius": 0.0001
  },
  "training": {
    "epochs": 32,
    "batchSize": 4096,
    "evaluationBatchSize": 8192,
    "learningRate": 0.00001,
    "optimizer": {
      "type": "hybrid-muon-adamw",
      "muon": {
        "momentum": 0.95,
        "nesterov": true,
        "newtonSchulzSteps": 3,
        "adjustLearningRate": "match_rms_adamw",
        "epsilon": 1e-7,
        "weightDecay": 0
      },
      "adamw": {
        "betas": [0.9, 0.999],
        "epsilon": 1e-8,
        "weightDecay": 0
      }
    },
    "learningRateSchedule": {
      "type": "reduce-on-validation-plateau",
      "factor": 0.5,
      "patience": 3,
      "threshold": 0.000001,
      "minimumLearningRate": 0.000001
    },
    "earlyStoppingPatience": 8,
    "gradientClip": 10,
    "seed": 1337,
    "device": "cuda",
    "mixedPrecision": "bfloat16"
  }
}
