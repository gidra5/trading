{
  "id": "compressed-path-density-h15-q128-256-512cap-feature59-train512k-ema4-v1",
  "label": "Compressed path density - 15 active 1s returns - Q 128→256→512 cap - immediate 59-feature state - 512k clean - no SAM - weight EMA 4 epochs",
  "datasetDir": "data/training/datasets/next-return-production-basis-history120-4l-train512k-v1",
  "runDir": "data/training/runs/compressed-path-density-h15-q128-256-512cap-feature59-train512k-ema4-v1",
  "historyDir": "data/market/immutable/refs/candles/spot-btcusdt/btcusdt/1s",
  "subset": {
    "type": "fixed-clean-count",
    "examples": 512000
  },
  "architecture": {
    "contract": "compressed-fifteen-active-return-low-rank-transport-path-density-v2",
    "marketWidth": 512,
    "returnCount": 15,
    "stateWidths": [128, 256, 512, 512, 512, 512, 512, 512, 512, 512, 512, 512, 512, 512, 512],
    "transition": "diag(1-g)*fixed-knot-transport + g*learned-destination-factor",
    "downProjection": "normalized-GLU(concat(previous-q,dynamic-transition-factor))",
    "initialRadius": 0.0031622776601683794,
    "minimumRadius": 0.0001,
    "learnableCentering": false
  },
  "training": {
    "epochs": 512,
    "batchSize": 2048,
    "evaluationBatchSize": 4096,
    "epochTrainEvaluationExamples": 65536,
    "learningRate": 0.0001,
    "optimizer": {
      "type": "hybrid-muon-adamw",
      "muon": {
        "momentum": 0.95,
        "nesterov": true,
        "newtonSchulzSteps": 3,
        "adjustLearningRate": "match_rms_adamw",
        "epsilon": 1e-7,
        "weightDecay": 0
      },
      "adamw": {
        "betas": [0.9, 0.999],
        "epsilon": 1e-8,
        "weightDecay": 0
      }
    },
    "weightEma": {
      "type": "optimizer-step-parameter-ema",
      "halfLifeEpochs": 4,
      "usedForEvaluationAndSelection": true
    },
    "adversarialInput": null,
    "gradientClip": 100,
    "seed": 1337,
    "device": "cuda",
    "mixedPrecision": "float32"
  },
  "density": {
    "source": "data/benchmarks/one-second-return-knot-scaling-v1.json",
    "fitsByStep": [128, 256, 512, 512, 512, 512, 512, 512, 512, 512, 512, 512, 512, 512, 512],
    "targetFilter": "each start and every path target are exact-nonzero active returns",
    "trainingLoss": "mean marginal return-density NLL across 15 steps"
  }
}
