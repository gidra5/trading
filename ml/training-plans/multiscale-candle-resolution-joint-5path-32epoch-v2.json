{
  "id": "multiscale-candle-resolution-joint-5path-32epoch-v2",
  "label": "Common-corpus joint telescoping MA depth screen for next five aligned 1m and 1h returns",
  "sourceDatasetDir": "data/training/datasets/mlp-direct-oracle-temporal-v12-delay-3600s-full-minute-oracle",
  "historyDir": "data/market/immutable/refs/candles/spot-btcusdt/btcusdt/1s",
  "datasetDirTemplate": "data/training/datasets/multiscale-candle-{resolution}-{maxWindow}-5path-v2",
  "runDirTemplate": "data/training/runs/multiscale-candle-{resolution}-{maxWindow}-joint-5path-32epoch-v2",
  "testExamples": 15000,
  "testTailOffsetExamples": 2515000,
  "evaluateTest": false,
  "resolutions": ["1m", "1h"],
  "comparisonMaxWindow": "3M",
  "architecture": {
    "contract": "telescoping-return-moving-average-two-layer-normalized-glu-v1",
    "widths": [512, 512],
    "inputNormalization": "training-position",
    "dropout": 0.05,
    "dropoutRate": 0.5,
    "initialRadius": 0.0031622776601683794,
    "minimumRadius": 0.0001
  },
  "training": {
    "epochs": 32,
    "byResolution": {
      "1m": {
        "batchSize": 4096,
        "evaluationBatchSize": 8192,
        "normalizationBatchSize": 8192
      },
      "1h": {
        "batchSize": 128,
        "evaluationBatchSize": 256,
        "normalizationBatchSize": 256
      }
    },
    "learningRate": 0.0001,
    "optimizer": {
      "type": "hybrid-muon-adamw",
      "muon": {
        "momentum": 0.95,
        "nesterov": true,
        "newtonSchulzSteps": 3,
        "adjustLearningRate": "match_rms_adamw",
        "epsilon": 1e-7,
        "weightDecay": 0
      },
      "adamw": {
        "betas": [0.9, 0.999],
        "epsilon": 1e-8,
        "weightDecay": 0
      }
    },
    "learningRateSchedule": {
      "type": "reduce-on-validation-plateau",
      "factor": 0.5,
      "patience": 3,
      "threshold": 0.000001,
      "minimumLearningRate": 0.000001
    },
    "earlyStoppingPatience": 8,
    "gradientClip": 100,
    "seed": 1337,
    "device": "cuda",
    "mixedPrecision": "bfloat16"
  }
}
