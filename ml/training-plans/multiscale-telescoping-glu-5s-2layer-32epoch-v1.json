{
  "id": "multiscale-telescoping-glu-5s-2layer-32epoch-v1",
  "label": "Telescoping 1m through 3M moving-average component GLU matrix",
  "sourceDatasetDir": "data/training/datasets/mlp-direct-oracle-temporal-v12-delay-3600s-full-minute-oracle",
  "historyDir": "data/market/immutable/refs/candles/spot-btcusdt/btcusdt/1s",
  "datasetDirTemplate": "data/training/datasets/multiscale-telescoping-glu-5s-{maxWindow}-v1",
  "runDirTemplate": "data/training/runs/multiscale-telescoping-glu-5s-{maxWindow}-{variant}-32epoch-v1",
  "horizonSeconds": 5,
  "testExamples": 15000,
  "testTailOffsetExamples": 2515000,
  "evaluateTest": false,
  "maxWindows": ["1m", "1h", "1d", "1w", "1M", "3M"],
  "variants": ["separate-components", "joint-input"],
  "objective": {
    "candleWeight": 1,
    "cumulativeReturnWeight": 1,
    "otherSummaryMetricWeights": 0,
    "selection": "summed raw-return validation objective"
  },
  "architecture": {
    "contract": "telescoping-return-moving-average-two-layer-normalized-glu-v1",
    "widths": [512, 512],
    "inputNormalization": "training-position",
    "dropout": 0.05,
    "dropoutRate": 0.5,
    "initialRadius": 0.0031622776601683794,
    "minimumRadius": 0.0001
  },
  "training": {
    "epochs": 32,
    "jointBatchSize": 65536,
    "separateBatchSizePerComponent": 131072,
    "evaluationBatchSize": 65536,
    "normalizationBatchSize": 32768,
    "learningRate": 0.0001,
    "optimizer": {
      "type": "hybrid-muon-adamw",
      "muon": {
        "momentum": 0.95,
        "nesterov": true,
        "newtonSchulzSteps": 3,
        "adjustLearningRate": "match_rms_adamw",
        "epsilon": 1e-7,
        "weightDecay": 0
      },
      "adamw": {
        "betas": [0.9, 0.999],
        "epsilon": 1e-8,
        "weightDecay": 0
      }
    },
    "learningRateSchedule": {
      "type": "reduce-on-validation-plateau",
      "factor": 0.5,
      "patience": 3,
      "threshold": 0.000001,
      "minimumLearningRate": 0.000001
    },
    "earlyStoppingPatience": 8,
    "gradientClip": 100,
    "seed": 1337,
    "device": "cuda",
    "mixedPrecision": "bfloat16"
  }
}
