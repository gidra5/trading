{
  "id": "normalized-glu-next-15-second-returns-cumulative-weighted-v2",
  "label": "One normalized GLU: next 15x1s returns with 2x cumulative summary weight",
  "sourceDatasetDir": "data/training/datasets/mlp-direct-oracle-temporal-v12-delay-3600s-full-minute-oracle",
  "datasetDir": "data/training/datasets/normalized-glu-next-15-second-returns-cumulative-weighted-v2",
  "runDir": "data/training/runs/normalized-glu-next-15-second-returns-cumulative-weighted-v2",
  "historyDir": "data/market/immutable/refs/candles/spot-btcusdt/btcusdt/1s",
  "horizonSeconds": 15,
  "testExamples": 1000000,
  "testTailOffsetExamples": 1000000,
  "objective": {
    "contract": "train-normalized-per-candle-mse-plus-mean-variance-min-max-compounded-cumulative-return-mse-v1",
    "candleWeight": 1,
    "summaryWeight": 1,
    "summaryMetrics": [
      "mean",
      "variance",
      "minimum",
      "maximum",
      "cumulativeReturn"
    ],
    "summaryMetricWeights": {
      "mean": 1,
      "variance": 1,
      "minimum": 1,
      "maximum": 1,
      "cumulativeReturn": 2
    }
  },
  "architecture": {
    "contract": "next-return-fused-glu-stack-independent-branch-centering-sqrt-learned-radius-full-a-post-bias-v2",
    "widths": [512],
    "dropout": 0.05,
    "dropoutRate": 0.5,
    "initialRadius": 0.0031622776601683794,
    "minimumRadius": 0.0001
  },
  "training": {
    "epochs": 24,
    "batchSize": 32768,
    "evaluationBatchSize": 65536,
    "learningRate": 0.0001,
    "optimizer": {
      "type": "hybrid-muon-adamw",
      "muon": {
        "momentum": 0.95,
        "nesterov": true,
        "newtonSchulzSteps": 3,
        "adjustLearningRate": "match_rms_adamw",
        "epsilon": 1e-7,
        "weightDecay": 0
      },
      "adamw": {
        "betas": [0.9, 0.999],
        "epsilon": 1e-8,
        "weightDecay": 0
      }
    },
    "learningRateSchedule": {
      "type": "reduce-on-validation-plateau",
      "factor": 0.5,
      "patience": 4,
      "threshold": 0.000001,
      "minimumLearningRate": 0.000001
    },
    "earlyStoppingPatience": 8,
    "gradientClip": 100,
    "seed": 1337,
    "device": "cuda",
    "mixedPrecision": "bfloat16"
  }
}
