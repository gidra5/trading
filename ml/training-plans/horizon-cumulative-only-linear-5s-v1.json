{
  "id": "horizon-cumulative-only-linear-5s-v1",
  "label": "Linear 120x1s to next 5x1s candle plus cumulative-return loss",
  "sourceDatasetDir": "data/training/datasets/mlp-direct-oracle-temporal-v12-delay-3600s-full-minute-oracle",
  "datasetDir": "data/training/datasets/horizon-cumulative-only-linear-5s-v1",
  "runDir": "data/training/runs/horizon-cumulative-only-linear-5s-v1",
  "normalizationDatasetDir": "data/training/datasets/horizon-screen-linear-5s-v1",
  "historyDir": "data/market/immutable/refs/candles/spot-btcusdt/btcusdt/1s",
  "horizonSeconds": 5,
  "testExamples": 15000,
  "testTailOffsetExamples": 2500000,
  "evaluateTest": false,
  "objective": {
    "contract": "train-normalized-per-candle-mse-plus-mean-variance-min-max-compounded-cumulative-return-mse-v1",
    "candleWeight": 1,
    "summaryWeight": 1,
    "summaryMetrics": ["mean", "variance", "minimum", "maximum", "cumulativeReturn"],
    "summaryMetricWeights": {"mean": 0, "variance": 0, "minimum": 0, "maximum": 0, "cumulativeReturn": 1}
  },
  "architecture": {"type": "linear", "contract": "train-normalized-linear-return-path-v1"},
  "training": {
    "epochs": 16,
    "batchSize": 262144,
    "evaluationBatchSize": 262144,
    "learningRate": 0.001,
    "optimizer": {"type": "adamw", "betas": [0.9, 0.999], "epsilon": 1e-8, "weightDecay": 0},
    "learningRateSchedule": {"type": "reduce-on-validation-plateau", "factor": 0.5, "patience": 3, "threshold": 0.000001, "minimumLearningRate": 0.000001},
    "earlyStoppingPatience": 5,
    "gradientClip": 100,
    "seed": 1337,
    "device": "cuda",
    "mixedPrecision": "bfloat16"
  }
}
