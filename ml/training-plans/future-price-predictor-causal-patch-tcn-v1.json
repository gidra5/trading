{
  "id": "future-price-predictor-causal-patch-tcn-v1",
  "label": "Close-log-return capability screen · learned patches + causal fused-GLU TCN",
  "corpusId": "future-price-predictor-close-log-return-v1",
  "sourceDatasetDir": "data/training/datasets/mlp-direct-oracle-temporal-v12-delay-3600s-full-minute-oracle",
