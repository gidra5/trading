{
  "id": "linear-next-15-second-returns-cumulative-weighted-v1",
  "label": "Linear 120x1s to next 15x1s returns with 2x cumulative summary weight",
  "sourceDatasetDir": "data/training/datasets/mlp-direct-oracle-temporal-v12-delay-3600s-full-minute-oracle",
  "datasetDir": "data/training/datasets/linear-next-15-second-returns-cumulative-weighted-v1",
  "runDir": "data/training/runs/linear-next-15-second-returns-cumulative-weighted-v1",
  "historyDir": "data/market/immutable/refs/candles/spot-btcusdt/btcusdt/1s",
  "horizonSeconds": 15,
  "testExamples": 500000,
  "testTailOffsetExamples": 2000000,
  "objective": {
    "contract": "train-normalized-per-candle-mse-plus-mean-variance-min-max-compounded-cumulative-return-mse-v1",
    "candleWeight": 1,
    "summaryWeight": 1,
    "summaryMetrics": [
      "mean",
      "variance",
      "minimum",
      "maximum",
      "cumulativeReturn"
    ],
    "summaryMetricWeights": {
      "mean": 1,
      "variance": 1,
      "minimum": 1,
      "maximum": 1,
      "cumulativeReturn": 2
    }
  },
  "architecture": {
    "type": "linear",
    "contract": "train-normalized-linear-return-path-v1"
  },
  "training": {
    "epochs": 24,
    "batchSize": 65536,
    "evaluationBatchSize": 131072,
    "learningRate": 0.001,
    "optimizer": {
      "type": "adamw",
      "betas": [0.9, 0.999],
      "epsilon": 1e-8,
      "weightDecay": 0
    },
    "learningRateSchedule": {
      "type": "reduce-on-validation-plateau",
      "factor": 0.5,
      "patience": 4,
      "threshold": 0.000001,
      "minimumLearningRate": 0.000001
    },
    "earlyStoppingPatience": 8,
    "gradientClip": 100,
    "seed": 1337,
    "device": "cuda",
    "mixedPrecision": "bfloat16"
  }
}
