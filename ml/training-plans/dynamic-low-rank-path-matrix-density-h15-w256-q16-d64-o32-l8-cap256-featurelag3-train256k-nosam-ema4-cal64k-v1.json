{
  "id": "dynamic-low-rank-path-matrix-density-h15-w256-q16-d64-o32-l8-cap256-featurelag3-train256k-nosam-ema4-cal64k-v1",
  "label": "Dynamic low-rank path matrix density - 15 active 1s returns - lag-0/1/2 59-feature state - W256 - Q16 - D64 - O32 - L8 - hidden cap256 - 256k clean - no SAM - weight EMA 4 epochs - online per-step affine 64k validation",
  "datasetDir": "data/training/datasets/next-return-production-basis-history120-4l-train512k-v1",
  "runDir": "data/training/runs/dynamic-low-rank-path-matrix-density-h15-w256-q16-d64-o32-l8-cap256-featurelag3-train256k-nosam-ema4-cal64k-v1",
  "historyDir": "data/market/immutable/refs/candles/spot-btcusdt/btcusdt/1s",
  "subset": {
    "type": "fixed-clean-count",
    "examples": 256000
  },
  "architecture": {
    "contract": "dynamic-low-rank-path-matrix-density-v1",
    "inputFeatureLags": 3,
    "marketWidth": 256,
    "pathEmbeddingWidth": 16,
    "pathCount": 64,
    "returnCount": 15,
    "outputKnots": 32,
    "matrixRank": 8,
    "hiddenWidthCap": 256,
    "marketState": "m0=GNGLU(concat(feature[t-2:t]),W); m_s=GNGLU(m_s-1,W)",
    "dynamicMatrix": "M_s(x)=learned-base_s + A_s(x)B_s(x)/sqrt(L)",
    "pathWeights": "q_s=softmax(row-dot(P_s,QD_s)/sqrt(Q))",
    "conditionalReturns": "T_s=row-softmax(P_s R_s/sqrt(Q)); J_s=q_s[:,None] times T_s; p_s=sum_D(J_s)",
    "pathTransition": "P_s+1=M_s(concat(P_s,m_s,J_s,point-state_s))",
    "outputPoints": "ordered market-conditioned unit-interval knots initialized from the fixed global 32-knot grid",
    "initialRadius": 0.0031622776601683794,
    "minimumRadius": 0.0001,
    "learnableCentering": false
  },
  "training": {
    "epochs": 512,
    "batchSize": 1024,
    "evaluationBatchSize": 512,
    "epochTrainEvaluationExamples": 65536,
    "learningRate": 0.0001,
    "optimizer": {
      "type": "hybrid-muon-adamw",
      "muon": {
        "momentum": 0.95,
        "nesterov": true,
        "newtonSchulzSteps": 3,
        "adjustLearningRate": "match_rms_adamw",
        "epsilon": 1e-7,
        "weightDecay": 0
      },
      "adamw": {
        "betas": [0.9, 0.999],
        "epsilon": 1e-8,
        "weightDecay": 0
      }
    },
    "sam": null,
    "weightEma": {
      "type": "optimizer-step-parameter-ema",
      "halfLifeEpochs": 4,
      "usedForEvaluationAndSelection": true
    },
    "adversarialInput": null,
    "gradientClip": 100,
    "seed": 1337,
    "device": "cuda",
    "mixedPrecision": "float32"
  },
  "validationCalibration": {
    "type": "online-affine-log-per-step",
    "datasetDir": "data/training/datasets/next-return-production-basis-history3-calibration-tail-64k-v1",
    "windowActiveReturns": 64000,
    "ridge": 0,
    "causal": true,
    "usedForCheckpointSelection": ["validation-mse", "validation-correlation"]
  },
  "density": {
    "source": "data/benchmarks/one-second-return-knot-scaling-v1.json",
    "fit": 32,
    "targetFilter": "each start and every path target are exact-nonzero active returns",
    "trainingLoss": "mean dynamic marginal return-density NLL across 15 steps"
  }
}
